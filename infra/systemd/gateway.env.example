# /etc/ecsi-gateway/gateway.env (root:ecsi-gateway, 0640) - agent passerelle ECSI CLOUD.
# Valeurs d'EXEMPLE : remplacer chaque « remplacer-… ». Ne jamais commiter le fichier réel.
NODE_ENV=production
LOG_LEVEL=info
# Rôle ecsi_worker uniquement (fonctions de la migration 0006), jamais ecsi_app ni ecsi_auth.
DATABASE_WORKER_URL=postgres://ecsi_worker:remplacer-mot-de-passe@base.interne:5432/ecsi
# Mêmes clés SecretBox que l'API et le worker (chiffrement du mot de passe RouterOS reçu).
ENCRYPTION_KEY=remplacer-cle-base64-32-octets
ENCRYPTION_KEY_ID=k2
ENCRYPTION_PREVIOUS_KEYS=
ROUTER_TUNNEL_CIDR=10.200.0.0/24
ROUTER_TUNNEL_GATEWAY=10.200.0.1
ROUTER_ACTIVATION_PORT=8081
WG_INTERFACE=wg0
WG_COMMAND=/usr/bin/wg
GATEWAY_SYNC_INTERVAL_SECONDS=5
