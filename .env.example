# ECSI CLOUD — variables d'environnement (MODÈLE, sans secret réel).
#
# Développement : `docker compose up` fonctionne sans ce fichier (valeurs « devonly »).
# Pour personnaliser : `cp .env.example .env` ou `./scripts/generate-dev-env.sh`
# (génère des mots de passe aléatoires). Le fichier .env n'est JAMAIS commité.
#
# Production : ces valeurs viennent du gestionnaire de secrets (voir docs/SECURITY.md).
# L'API refuse de démarrer en production si une valeur contient « devonly ».

# --- Général ---
NODE_ENV=development
APP_VERSION=0.1.0-dev
LOG_LEVEL=info
# Journaux lisibles pour `pnpm dev` uniquement (JSON en Docker et en production).
LOG_PRETTY=true

# --- PostgreSQL ---
POSTGRES_DB=ecsi
POSTGRES_PASSWORD=devonly-postgres-password
ECSI_DB_MIGRATOR_PASSWORD=devonly-migrator-password
ECSI_DB_APP_PASSWORD=devonly-app-password
ECSI_DB_AUTH_PASSWORD=devonly-auth-password
# Utilisés par `pnpm dev` (API lancée hors Docker, base dans Docker sur localhost).
DATABASE_URL=postgres://ecsi_app:devonly-app-password@localhost:5432/ecsi
DATABASE_MIGRATOR_URL=postgres://ecsi_migrator:devonly-migrator-password@localhost:5432/ecsi
DATABASE_AUTH_URL=postgres://ecsi_auth:devonly-auth-password@localhost:5432/ecsi

# --- Redis ---
REDIS_PASSWORD=devonly-redis-password
REDIS_URL=redis://:devonly-redis-password@localhost:6379

# --- Stockage objet S3 compatible ---
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=ecsi-dev
S3_ACCESS_KEY_ID=ecsi-devonly
S3_SECRET_ACCESS_KEY=devonly-s3-secret-key
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# --- API ---
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:8081

# --- Authentification ---
# Secret de signature des jetons d'accès (32 caractères minimum) : openssl rand -base64 48
JWT_ACCESS_SECRET=devonly-jwt-access-secret-change-me-0000
# Clé AES-256-GCM des secrets stockés (TOTP), 32 octets en base64 : openssl rand -base64 32
ENCRYPTION_KEY=devonlydevonlydevonlydevonlydevonlydevonlyA=
# HTTP en local uniquement. Obligatoirement true en production (HTTPS).
COOKIE_SECURE=false
# URL du dashboard utilisée dans les liens des e-mails (réinitialisation, invitation).
WEB_PUBLIC_URL=http://localhost:8080
# Mot de passe des comptes de démonstration créés par `pnpm db:seed` (jamais en production).
SEED_PASSWORD=devonly-demo-password

# --- Dashboard (Next.js) ---
API_INTERNAL_URL=http://localhost:4000

# --- E-mail (Mailpit en développement) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="ECSI CLOUD <no-reply@ecsi.local>"
